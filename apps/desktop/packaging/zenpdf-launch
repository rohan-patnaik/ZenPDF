#!/bin/sh
set -u

umask 077
state_root=${XDG_STATE_HOME:-"${HOME:?HOME is required}/.local/state"}
state_dir=$state_root/zenpdf
log_path=$state_dir/launcher.log
mkdir -p "$state_dir" || {
  printf '%s\n' "ZenPDF launcher could not create its private state directory: $state_dir" >&2
  exit 1
}
chmod 700 "$state_dir" 2>/dev/null || true
: >"$log_path" || {
  printf '%s\n' "ZenPDF launcher could not create its private startup log: $log_path" >&2
  exit 1
}
chmod 600 "$log_path" 2>/dev/null || true

diagnose() {
  message=$1
  printf '%s\n' "$message" >&2
  printf '%s\n' "$message" >>"$log_path"
  chmod 600 "$log_path" 2>/dev/null || true
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name=ZenPDF "Unable to launch ZenPDF" "$message" >/dev/null 2>&1 || true
  fi
}

binary=$(command -v zenpdf 2>/dev/null || true)
if [ -z "$binary" ]; then
  diagnose "ZenPDF is not installed or is not available in PATH. Install the ZenPDF Arch package and ensure /usr/bin is in PATH."
  exit 127
fi

capture_pipe=$state_dir/launcher-output.$$
status_path=$state_dir/launcher-status.$$
if ! mkfifo -m 600 "$capture_pipe"; then
  diagnose "ZenPDF launcher could not create a private startup diagnostic channel."
  exit 1
fi
nohup sh -c '
  dd bs=1024 count=60 of="$1" 2>/dev/null
  cat >/dev/null
  rm -f "$2"
' zenpdf-capture "$log_path" "$capture_pipe" <"$capture_pipe" >/dev/null 2>&1 &
capture_pid=$!
nohup sh -c '
  "$1"
  status=$?
  printf "%s\n" "$status" >"$2"
  (sleep 5; rm -f "$2") </dev/null >/dev/null 2>&1 &
  exit "$status"
' zenpdf-wrapper "$binary" "$status_path" >"$capture_pipe" 2>&1 &
pid=$!
grace_seconds=${ZENPDF_LAUNCH_GRACE_SECONDS:-1}
sleep "$grace_seconds"
if kill -0 "$pid" 2>/dev/null; then
  exit 0
fi

status=1
if wait "$pid"; then
  status=0
else
  status=$?
fi
wait "$capture_pid" 2>/dev/null || true
if [ -r "$status_path" ]; then
  status=$(sed -n '1p' "$status_path")
fi
diagnose "ZenPDF exited during startup (status $status). Review $log_path for details or run zenpdf in a terminal."
exit "$status"
